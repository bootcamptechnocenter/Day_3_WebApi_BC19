{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/easycredit-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{CorrelationId}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Oracle": "",
    "Postgres": "Host=localhost;Port=5432;Database=easycredit;Username=postgres;Password="
  },
  "Database": {
    "Provider": "Oracle"
  },
  "CreditScoreApi": {
    "BaseUrl": "",
    "ApiKey": "",
    "TimeoutSeconds": 5,
    "UseRefit": false
  },
  "ApiKey": "",
  "Jwt": {
    "Key": "",
    "Issuer": "EasyCredit.Api",
    "Audience": "EasyCredit.Client",
    "ExpiryMinutes": 60
  }
}
